filters:
  and:
    - file.inFolder("The Library/Book Catalog and Notes")
views:
  - type: table
    name: Table
    order:
      - title
      - author
      - url
      - pages
      - file.name
    sort:
      - property: file.name
        direction: ASC
      - property: title
        direction: DESC
      - property: pages
        direction: DESC
      - property: url
        direction: ASC
    columnSize:
      note.title: 285
      note.author: 197
  - type: cards
    name: View
    filters:
      and:
        - file.hasTag("📕Book")
    rowHeight: medium
    image: file.file
    imageFit: ""
